FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# 配置pip使用官方PyPI源（更稳定，更新及时）
RUN pip config set global.index-url https://pypi.org/simple

# 安装系统依赖（主要用于 psycopg 等）
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    pkg-config \
    python3-dev \
    gcc \
    tzdata \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# 分步升级和安装依赖，提高稳定性
RUN pip install --upgrade pip setuptools wheel || pip install --upgrade pip setuptools wheel --default-timeout=100

# 尝试安装依赖，如果失败则重试
RUN pip install -r requirements.txt || \
    (echo "First attempt failed, retrying..." && \
     pip install -r requirements.txt --default-timeout=200 --retries 3)

COPY . .

# 使用 Gunicorn 作为生产 WSGI 服务
CMD ["gunicorn", "compostlab_v2.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120"]

