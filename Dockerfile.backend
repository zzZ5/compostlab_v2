FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# Use the official PyPI index.
RUN pip config set global.index-url https://pypi.org/simple

# Prefer Python wheels so fresh environments do not depend on apt packages.
COPY requirements.txt .

# Upgrade packaging tools first, then install application dependencies.
RUN pip install --upgrade pip setuptools wheel || pip install --upgrade pip setuptools wheel --default-timeout=100

# Retry once to handle transient PyPI/network failures.
RUN pip install -r requirements.txt || \
    (echo "First attempt failed, retrying..." && \
     pip install -r requirements.txt --default-timeout=200 --retries 3)

COPY . .

# Use Gunicorn as the production WSGI server.
CMD ["sh", "-c", "python manage.py collectstatic --noinput >/dev/null && gunicorn compostlab_v2.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120"]
